# === Base de datos PostgreSQL (Neon) ===
# Formato: jdbc:postgresql://<neon-host>/<database>?sslmode=require
# Ejemplo: jdbc:postgresql://ep-xxx-xxx.us-east-2.aws.neon.tech/hmap_db?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/hmap_db
DATABASE_USERNAME=your_username
DATABASE_PASSWORD=your_password

# === JWT Secret ===
JWT_SECRET=tu-secreto-jwt-muy-seguro-cambiar-en-produccion

# === Correo (SMTP) ===
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=tu-usuario-mailtrap
MAIL_PASSWORD=tu-password-mailtrap
MAIL_FROM=no-reply@hmap.com

# === Frontend ===
FRONTEND_RESET_URL=https://tu-frontend.com/reset-password
RESET_TOKEN_MINUTES=30

# === Reservas ===
RESERVATION_EDIT_WINDOW_HOURS=48

# === Imágenes (Cloudinary) ===
# Base URL de Cloudinary para servir las imágenes
# Ejemplo: https://res.cloudinary.com/tu-cloud/image/upload
IMAGES_BASE_URL=https://res.cloudinary.com/tu-cloud/image/upload
