# ============================================================
# VARIABLES DE ENTORNO - HMAP API
# ============================================================
#
# Este archivo es una PLANTILLA. Cópialo a .env y ajusta los valores.
#
# IMPORTANTE:
# - .env NO se sube a git (está en .gitignore)
# - En desarrollo local, Spring usa el perfil "dev" por defecto
# - En producción (Render), configura estas variables en el dashboard

# === Base de datos ===
# DESARROLLO: PostgreSQL local
# PRODUCCIÓN: Supabase connection string
DATABASE_URL=jdbc:postgresql://localhost:5432/hmap_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# === JWT Secret ===
# DESARROLLO: Cualquier string (mínimo 8 caracteres)
# PRODUCCIÓN: Genera uno seguro con: openssl rand -base64 32
JWT_SECRET=12345678

# === Correo (SMTP) ===
# DESARROLLO: Mailtrap (https://mailtrap.io)
# PRODUCCIÓN: SendGrid, Mailgun, AWS SES, etc.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@hmap.com

# === Frontend ===
# DESARROLLO: http://localhost:5173/reset-password
# PRODUCCIÓN: https://hmap-front.vercel.app/reset-password
FRONTEND_RESET_URL=http://localhost:5173/reset-password

# === Imágenes (Cloudinary) ===
# DESARROLLO: Dejar vacío (opcional)
# PRODUCCIÓN: https://res.cloudinary.com/tu-cloud/image/upload
IMAGES_BASE_URL=

# === Configuración de reservas ===
RESERVATION_EDIT_WINDOW_HOURS=48
RESET_TOKEN_MINUTES=30
